<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="using:Material3.Avalonia"
             x:Class="LiarUtil.Gui.App">

  <Application.Resources>
    <FontFamily x:Key="Md3FontFamilyPlain">avares://LiarUtil.Gui/Assets/Fonts/wqy-microhei.ttc#WenQuanYi Micro Hei, Roboto, sans-serif</FontFamily>
    <FontFamily x:Key="Md3FontFamilyBrand">avares://LiarUtil.Gui/Assets/Fonts/wqy-microhei.ttc#WenQuanYi Micro Hei, Roboto, sans-serif</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <m3:MaterialTheme SeedColor="#6750A4" />
  </Application.Styles>

</Application>
