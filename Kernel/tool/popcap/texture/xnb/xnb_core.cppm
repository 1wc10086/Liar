export module tool.popcap.texture.xnb.xnb_core;
import utility.io;
import utility.png.png;
import utility.binary.unified_binary_stream;
import tool.popcap.texture.texture_core;
export {
namespace ImageXnbCodec {
    inline const uint8_t XNB_MAGIC[]={0x58,0x4E,0x42,0x6D,0x05,0x00};
    inline const uint8_t XNB_INFO[]={0x01,0x94,0x01,0x4D,0x69,0x63,0x72,0x6F,0x73,0x6F,0x66,0x74,0x2E,0x58,0x6E,0x61,0x2E,0x46,0x72,0x61,0x6D,0x65,0x77,0x6F,0x72,0x6B,0x2E,0x43,0x6F,0x6E,0x74,0x65,0x6E,0x74,0x2E,0x54,0x65,0x78,0x74,0x75,0x72,0x65,0x32,0x44,0x52,0x65,0x61,0x64,0x65,0x72,0x2C,0x20,0x4D,0x69,0x63,0x72,0x6F,0x73,0x6F,0x66,0x74,0x2E,0x58,0x6E,0x61,0x2E,0x46,0x72,0x61,0x6D,0x65,0x77,0x6F,0x72,0x6B,0x2E,0x47,0x72,0x61,0x70,0x68,0x69,0x63,0x73,0x2C,0x20,0x56,0x65,0x72,0x73,0x69,0x6F,0x6E,0x3D,0x34,0x2E,0x30,0x2E,0x30,0x2E,0x30,0x2C,0x20,0x43,0x75,0x6C,0x74,0x75,0x72,0x65,0x3D,0x6E,0x65,0x75,0x74,0x72,0x61,0x6C,0x2C,0x20,0x50,0x75,0x62,0x6C,0x69,0x63,0x4B,0x65,0x79,0x54,0x6F,0x6B,0x65,0x6E,0x3D,0x38,0x34,0x32,0x63,0x66,0x38,0x62,0x65,0x31,0x64,0x65,0x35,0x30,0x35,0x35,0x33,0x00,0x00,0x00,0x00,0x00,0x01};
    inline void decode(const std::string& in, const std::string& out) {
        auto data = FileUtils::readFileBytes(in); UnifiedBinaryStream bs(data);
        bs.verifyBytes(XNB_MAGIC, 6); (void)bs.readInt32(); bs.verifyBytes(XNB_INFO, 157); if(bs.readInt32()!=0) throw std::runtime_error("");
        int w=bs.readInt32(), h=bs.readInt32(); if(bs.readInt32()!=1) throw std::runtime_error(""); (void)bs.readInt32();
        std::unique_ptr<ImageBitmap> bmp(ABGR8888::read(bs, w, h)); bmp->save(out);
    }
    inline void encode(const std::string& in, const std::string& out) {
        std::unique_ptr<ImageBitmap> bmp(ImageBitmap::create(in)); UnifiedBinaryStream bs(UnifiedBinaryStream::Mode::Write); int w=bmp->getWidth(), h=bmp->getHeight(), tSz=w*h*4;
        bs.writeBytes(XNB_MAGIC, 6); bs.writeInt32(197+tSz); bs.writeBytes(XNB_INFO, 157); bs.writeInt32(0); bs.writeInt32(w); bs.writeInt32(h); bs.writeInt32(1); bs.writeInt32(tSz);
        ABGR8888::write(bs, bmp.get()); FileUtils::writeFileBytes(out, bs.getData());
    }
}

